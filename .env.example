APP_NAME=Talyvane
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

BRAND_NAME=Talyvane
BRAND_TAGLINE="Independent operations. Considered design."
BRAND_CONTACT_EMAIL=
VERIFICATION_APPROVED_PROVIDERS=
PROFILE_CONSENT_VERSION=profile-publication-v1
BRAND_CONTACT_PHONE=
BRAND_CONTACT_WEBSITE=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=talyvane
DB_USERNAME=talyvane
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false # Set true in production behind HTTPS
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
