APP_NAME=Talyvane
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

BRAND_NAME=Talyvane
BRAND_TAGLINE="Independent operations. Considered design."
BRAND_CONTACT_EMAIL=
VERIFICATION_APPROVED_PROVIDERS=
PROFILE_CONSENT_VERSION=profile-publication-v1

# Private-gallery consent is a separate optional purpose. Keep disabled until legal review approves the exact policy text.
PRIVATE_GALLERY_CONSENT_VERSION=
PRIVATE_GALLERY_CONSENT_APPROVED=false

# Model agency remains disabled until legal policies, applicant rights workflows and retention scheduling are approved.
MODEL_AGENCY_PRIVACY_NOTICE_VERSION=
MODEL_AGENCY_PRIVACY_NOTICE_APPROVED=false
MODEL_AGENCY_ADULT_ELIGIBILITY_POLICY_VERSION=
MODEL_AGENCY_ADULT_ELIGIBILITY_POLICY_APPROVED=false
MODEL_AGENCY_REPRESENTATION_TERMS_VERSION=
MODEL_AGENCY_REPRESENTATION_TERMS_APPROVED=false
MODEL_AGENCY_PORTFOLIO_CONSENT_VERSION=
MODEL_AGENCY_PORTFOLIO_CONSENT_APPROVED=false
MODEL_AGENCY_IMAGE_LICENCE_POLICY_VERSION=
MODEL_AGENCY_IMAGE_LICENCE_POLICY_APPROVED=false
MODEL_AGENCY_CASTING_POLICY_VERSION=
MODEL_AGENCY_CASTING_POLICY_APPROVED=false
MODEL_AGENCY_ASSIGNMENT_POLICY_VERSION=
MODEL_AGENCY_ASSIGNMENT_POLICY_APPROVED=false
MODEL_AGENCY_SETTLEMENT_POLICY_VERSION=
MODEL_AGENCY_SETTLEMENT_POLICY_APPROVED=false
MODEL_AGENCY_APPLICATION_RETENTION_DAYS=
MODEL_AGENCY_ACCEPTED_RETENTION_DAYS=
MODEL_AGENCY_RETENTION_SCHEDULE_APPROVED=false

# Optional external key custody for safeguarding case data. Keep local as the default.
# Use a dedicated HTTPS Vault Transit mount. Never reuse the application token as the retention token.
# The application token may create per-case keys and encrypt/decrypt; the retention token alone may enable deletion and destroy keys.
SAFEGUARDING_CASE_KEY_PROVIDER=local
SAFEGUARDING_VAULT_ADDRESS=
SAFEGUARDING_VAULT_MOUNT=transit
SAFEGUARDING_VAULT_TOKEN=
SAFEGUARDING_VAULT_RETENTION_TOKEN=
SAFEGUARDING_VAULT_TIMEOUT=5

# Optional Super Admin secret management through a dedicated HashiCorp Vault KV v2 mount.
# Provision a separate token with read/write on the configured prefix and delete on its metadata paths.
# Never reuse the safeguarding Transit token; secret values are not stored in the application database or shown again.
SECRETS_VAULT_ADDRESS=
SECRETS_VAULT_MOUNT=secret
SECRETS_VAULT_PREFIX=talyvane
SECRETS_VAULT_TOKEN=
SECRETS_VAULT_TIMEOUT=5

# Safeguarding case retention is disabled until the legal schedule and backup expiry are approved.
SAFEGUARDING_CASE_RETENTION_DAYS=0
SAFEGUARDING_CASE_RETENTION_POLICY_VERSION=
SAFEGUARDING_CASE_RETENTION_SCHEDULE_APPROVED=false
SAFEGUARDING_CASE_BACKUP_EXPIRY_DAYS=0
SAFEGUARDING_CASE_BACKUP_POLICY_APPROVED=false

# Safeguarding email notices are disabled until the mail transport and contacts are verified.
SAFEGUARDING_NOTIFICATIONS_ENABLED=false
SAFEGUARDING_EMERGENCY_CONTACT_EMAILS=
BRAND_CONTACT_PHONE=
BRAND_CONTACT_WEBSITE=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=talyvane
DB_USERNAME=talyvane
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false # Set true in production behind HTTPS
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
