Options -Indexes -MultiViews
DirectoryIndex index.php

# The single-ZIP payload is private staging material. Never serve it over HTTP.
<FilesMatch "(?i)(^\.|\.(zip|tar|gz|sql|log|bak|old)$|^composer\.(json|lock)$|^artisan$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Enforce private-file protection with rewrite rules as well as FilesMatch.
    # LiteSpeed-compatible deployments may not apply every Apache FilesMatch
    # rule in per-directory context, so sensitive paths must fail closed here.
    RewriteRule (^|/)\\.(?!well-known(?:/|$)) - [F,L]
    RewriteRule \\.(?:zip|tar|gz|sql|log|bak|old)$ - [F,L,NC]
    RewriteRule ^(?:composer\\.(?:json|lock)|artisan|phpunit\\.xml)$ - [F,L,NC]

    # /install is a Laravel route, not a public directory. The physical install/ directory stays private with the app payload.
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|tests|vendor)(?:/|$) - [F,L,NC]

    # Preserve authentication and XSRF headers for Laravel middleware.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:X-XSRF-TOKEN} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-TOKEN}]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
